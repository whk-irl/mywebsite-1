---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { publications, posts } from '../lib/content.js';
import portrait from '../../content/authors/admin/avatar.jpg';
const chosen = publications.filter((item) => item.featured || item.slug === 'conference-paper-thermal-masking-body');
---
<Base>
  <main id="main">
    <section class="hero" id="top"><div class="hero-background" aria-hidden="true"><span></span><span></span><span></span></div><div class="shell hero-wrap">
      <div class="hero-main"><div class="hero-overline"><span class="pulse-dot"></span> RESEARCHER &amp; ENGINEER <span class="slash">/</span> DALLAS, TEXAS</div><h1>Building for<br /><em>how we</em> <span>feel.</span></h1><p class="hero-deck">Exploring the space between medical technology, human perception, and the systems we interact with.</p><div class="hero-actions"><a class="button button-solid" href="#work">EXPLORE MY WORK <span>↘</span></a><a class="button button-ghost" href="/uploads/resume.pdf">DOWNLOAD CV <span>↗</span></a></div></div>
      <div class="hero-side"><div class="portrait-frame"><img src={portrait.src} alt="Haokun Wang" /><span class="portrait-label">PORTRAIT / 01</span><span class="portrait-corner">+</span></div><div class="portrait-caption"><span>HAOKUN WANG</span><span>INSTRUCTOR &amp; RESEARCHER</span></div></div>
      <div class="hero-bottom"><span>MEDICAL PHYSICS <b>✳</b> HAPTICS <b>✳</b> XR</span><a href="#about">SCROLL TO EXPLORE ↓</a></div>
    </div></section>

    <section class="intro-section section-pad" id="about"><div class="shell split-section"><div class="section-side"><p class="section-number">01 <span>/</span> PROFILE</p><div class="side-rule"></div><p class="side-note">RESEARCH AT THE<br />INTERSECTION OF<br />PEOPLE &amp; TECHNOLOGY.</p></div><div class="intro-main" data-reveal><p class="kicker"><span></span> A LITTLE ABOUT ME</p><h2>A human-centered<br />approach to <em>engineering.</em></h2><div class="intro-columns"><p>I’m an Instructor in the Medical Artificial Intelligence and Automation Lab at UT Southwestern Medical Center’s Department of Radiation Oncology. My work brings together medical physics, electrical engineering, and human-computer interaction.</p><p>My background spans wearable haptics, XR, hardware prototyping, and human-subject research. Today, I work on medical imaging segmentation, IoT patient tracking, and medical VR training.</p></div><div class="intro-links"><a class="underlined-link" href="/uploads/resume.pdf">MORE ABOUT MY EXPERIENCE <span>↗</span></a><a class="underlined-link" href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">GOOGLE SCHOLAR <span>↗</span></a></div></div></div></section>

    <section class="focus-section"><div class="shell focus-grid"><div class="focus-heading"><span>AREAS OF FOCUS</span><strong>Ideas grounded<br />in practice<span>.</span></strong></div><div class="focus-item"><span>01 / MEDICAL</span><h3>Medical technology</h3><p>Imaging, instrumentation, and human-centered systems for radiation oncology.</p></div><div class="focus-item"><span>02 / INTERACTION</span><h3>Haptics &amp; perception</h3><p>Wearable interfaces and multisensory feedback informed by psychophysics.</p></div><div class="focus-item"><span>03 / EXPERIENCE</span><h3>Extended reality</h3><p>Interactive environments that connect physical and digital experiences.</p></div></div></section>

    <section class="work-section section-pad" id="work"><div class="shell"><div class="section-top" data-reveal><div><p class="section-number">02 <span>/</span> SELECTED RESEARCH</p><h2>Research, <em>made tangible.</em></h2></div><div class="section-top-aside"><p>A selection of interfaces, experiments, and systems developed across haptics and XR.</p><a class="underlined-link" href="/publication/">ALL PUBLICATIONS <span>↗</span></a></div></div><div class="work-grid">{chosen.map((item, index) => <ResearchCard item={item} index={index} featured={index === 0} />)}</div><div class="archive-bar"><span>EXPLORE THE COMPLETE RESEARCH ARCHIVE</span><a href="/publication/">VIEW ALL PUBLICATIONS <span>↗</span></a></div></div></section>

    <section class="methods-section section-pad" id="approach"><div class="shell split-section"><div class="section-side"><p class="section-number">03 <span>/</span> PROCESS</p><div class="side-rule"></div><p class="side-note">FROM QUESTIONS<br />TO WORKING SYSTEMS.</p></div><div data-reveal><p class="kicker"><span></span> HOW I WORK</p><h2>Thoughtful ideas.<br /><em>Rigorous execution.</em></h2><div class="method-list"><div><span>01</span><h3>Investigate</h3><p>Frame meaningful problems through research, observation, and interdisciplinary inquiry.</p></div><div><span>02</span><h3>Prototype</h3><p>Bring concepts into the physical and digital world through hardware, software, and interaction design.</p></div><div><span>03</span><h3>Evaluate</h3><p>Test with people and data to understand what works, why it works, and where it can go next.</p></div></div></div></div></section>

    <section class="news-section section-pad" id="news"><div class="shell split-section"><div class="section-side"><p class="section-number">04 <span>/</span> UPDATES</p><div class="side-rule"></div></div><div><div class="news-heading"><div><p class="kicker"><span></span> FROM THE LAB</p><h2>Recent <em>notes.</em></h2></div><a class="underlined-link" href="/post/">ALL UPDATES <span>↗</span></a></div><div class="news-list">{posts.slice(0, 4).map((post) => <a href={`/post/${post.slug}/`}><time datetime={String(post.date)}>{new Date(post.date).toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).toUpperCase()}</time><span>{post.title}</span><span>↗</span></a>)}</div></div></div></section>

    <section class="contact-section" id="contact"><div class="shell"><div class="contact-top"><p class="section-number">05 <span>/</span> CONTACT</p><span>RESEARCH &amp; COLLABORATION</span></div><div class="contact-grid"><div><p class="kicker"><span></span> GET IN TOUCH</p><h2>Let's make<br /><em>something matter.</em></h2><a class="contact-email" href="mailto:haokun.wang@utsouthwestern.edu">haokun.wang@utsouthwestern.edu <span>↗</span></a></div><div class="contact-links"><span>ELSEWHERE</span><a href="https://www.linkedin.com/in/haokun-wang-854548239/">LINKEDIN <span>↗</span></a><a href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">GOOGLE SCHOLAR <span>↗</span></a><a href="https://github.com/whk-irl">GITHUB <span>↗</span></a></div></div></div></section>
  </main>
</Base>
