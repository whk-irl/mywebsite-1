---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { publications } from '../lib/content.js';
import portrait from '../assets/head.jpg';
const chosen = publications.filter((item) => item.featured || item.slug === 'conference-paper-thermal-masking-body').slice(0, 4);
---
<Base>
  <main id="main">
    <section class="hero" id="top">
      <div class="shell hero-wrap">
        <div class="hero-main">
          <p class="hero-overline">Instructor &amp; researcher <span class="hero-location">Dallas, Texas</span></p>
          <h1>Haokun Wang<span class="hero-period">.</span></h1>
          <p class="hero-deck">I’m an Instructor at UT Southwestern Medical Center working across medical AI, haptics, and extended reality. I build systems that connect software, sensors, and physical interfaces—from medical imaging and patient tracking to immersive training.</p>
          <div class="hero-actions"><a class="hero-link" href="#work">Selected work <span>↘</span></a><a class="hero-link muted-link" href="/uploads/resume.pdf">Download CV <span>↗</span></a></div>
        </div>
        <div class="hero-side"><div class="portrait-frame"><img src={portrait.src} alt="Haokun Wang" /></div><p class="portrait-caption"><span>Haokun Wang</span><span>UT Southwestern Medical Center</span></p></div>
      </div>
    </section>

    <section class="work-section section-pad" id="work"><div class="shell">
      <div class="editorial-section-head" data-reveal><div><p class="section-label">01 / Research</p><h2>Selected work</h2></div><p>Projects at the intersection of perception, interaction, and engineering.</p></div>
      <div class="work-grid">{chosen.map((item, index) => <ResearchCard item={item} index={index} />)}</div>
      <div class="archive-bar"><a href="/publication/">All publications <span>↗</span></a><span>{publications.length} publications</span></div>
    </div></section>

    <section class="intro-section section-pad" id="about"><div class="shell about-layout">
      <div><p class="section-label">02 / About</p><h2>Research that<br /><em>connects people<br />and technology.</em></h2></div>
      <div class="about-copy" data-reveal>
        <p>I’m an Instructor in the Medical Artificial Intelligence and Automation Lab, Department of Radiation Oncology, at UT Southwestern Medical Center. My current work includes medical imaging segmentation tools, an IoT patient-tracking system, and VR training for clinical education.</p>
        <p>I completed my Ph.D. in Electrical Engineering at the University of Texas at Dallas, where my research focused on haptics and multisensory interaction for AR and VR. I designed wearable and mid-air interfaces that bring thermal and tactile sensations into digital experiences.</p>
        <p>My work spans the full process of building a system: selecting actuators, developing embedded firmware and Unity applications, integrating sensors, processing signals, and evaluating prototypes with users.</p>
        <div class="about-links"><a href="/uploads/resume.pdf">Curriculum vitae ↗</a><a href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">Google Scholar ↗</a></div>
      </div>
    </div></section>

    <section class="contact-section" id="contact"><div class="shell contact-grid"><div><p class="section-label">03 / Contact</p><h2>Get in touch.</h2><p class="contact-intro">For research, collaborations, or a conversation about the work.</p><a class="contact-email" href="mailto:haokun.wang@utsouthwestern.edu">haokun.wang@utsouthwestern.edu <span>↗</span></a></div><div class="contact-links"><a href="https://www.linkedin.com/in/haokun-wang-854548239/">LinkedIn <span>↗</span></a><a href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">Google Scholar <span>↗</span></a><a href="https://github.com/whk-irl">GitHub <span>↗</span></a></div></div></section>
  </main>
</Base>
