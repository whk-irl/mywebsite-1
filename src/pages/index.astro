---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { publications, posts } from '../lib/content.js';
import portrait from '../../content/authors/admin/avatar.jpg';
const chosen = publications.filter((item) => item.featured || item.slug === 'conference-paper-thermal-masking-body').slice(0, 4);
---
<Base>
  <main id="main">
    <section class="hero" id="top">
      <div class="shell hero-wrap">
        <div class="hero-main">
          <p class="hero-overline">Instructor &amp; researcher <span class="hero-location">Dallas, Texas</span></p>
          <h1>Haokun<br />Wang<span class="hero-period">.</span></h1>
          <p class="hero-deck">I build systems for healthcare and human experience, working across medical AI, haptics, and extended reality.</p>
          <div class="hero-actions"><a class="hero-link" href="#work">Selected work <span>↘</span></a><a class="hero-link muted-link" href="/uploads/resume.pdf">Download CV <span>↗</span></a></div>
        </div>
        <div class="hero-side"><div class="portrait-frame"><img src={portrait.src} alt="Haokun Wang" /></div><p class="portrait-caption"><span>Haokun Wang</span><span>UT Southwestern Medical Center</span></p></div>
      </div>
    </section>

    <section class="work-section section-pad" id="work"><div class="shell">
      <div class="editorial-section-head" data-reveal><div><p class="section-label">01 / Research</p><h2>Selected work</h2></div><p>Projects at the intersection of perception, interaction, and engineering.</p></div>
      <div class="work-grid">{chosen.map((item) => <ResearchCard item={item} />)}</div>
      <div class="archive-bar"><a href="/publication/">All publications <span>↗</span></a><span>{publications.length} publications</span></div>
    </div></section>

    <section class="intro-section section-pad" id="about"><div class="shell about-layout">
      <div><p class="section-label">02 / About</p><h2>Research that<br /><em>connects people<br />and technology.</em></h2></div>
      <div class="about-copy" data-reveal><p>I’m an Instructor in the Medical Artificial Intelligence and Automation Lab, Department of Radiation Oncology, at UT Southwestern Medical Center.</p><p>My work includes medical imaging segmentation tools, an IoT patient tracking system, and medical VR training. My background is in electrical engineering and spans wearable haptics, XR, hardware prototyping, and human-subject research.</p><div class="about-links"><a href="/uploads/resume.pdf">Curriculum vitae ↗</a><a href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">Google Scholar ↗</a></div></div>
    </div></section>

    <section class="news-section section-pad" id="news"><div class="shell about-layout"><div><p class="section-label">03 / Updates</p><h2>Recent notes</h2></div><div><div class="news-list">{posts.slice(0, 4).map((post) => <a href={`/post/${post.slug}/`}><time datetime={String(post.date)}>{new Date(post.date).toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time><span>{post.title}</span><span>↗</span></a>)}</div><a class="text-link" href="/post/">All updates ↗</a></div></div></section>

    <section class="contact-section" id="contact"><div class="shell contact-grid"><div><p class="section-label">04 / Contact</p><h2>Get in touch.</h2><p class="contact-intro">For research, collaborations, or a conversation about the work.</p><a class="contact-email" href="mailto:haokun.wang@utsouthwestern.edu">haokun.wang@utsouthwestern.edu <span>↗</span></a></div><div class="contact-links"><a href="https://www.linkedin.com/in/haokun-wang-854548239/">LinkedIn <span>↗</span></a><a href="https://scholar.google.com/citations?user=AzitNLgAAAAJ&amp;hl=en">Google Scholar <span>↗</span></a><a href="https://github.com/whk-irl">GitHub <span>↗</span></a></div></div></section>
  </main>
</Base>
