---
const { item, index } = Astro.props;
---
<article class="research-card" data-reveal>
  <a class="research-row" href={`/publication/${item.slug}/`}>
    <span class="research-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="research-card-body">
      <p class="research-meta">{item.publication_short || 'Research'} <span> / </span> {item.year}</p>
      <h3>{item.title}</h3>
      <p class="research-topics">{(item.tags || []).slice(0, 2).join(' · ')}</p>
    </div>
    <div class="research-visual" aria-hidden="true">
      {item.image ? <img src={item.image} alt="" loading="lazy" /> : <div class="research-orbit"><i></i><i></i><i></i><span></span></div>}
    </div>
    <span class="research-arrow" aria-hidden="true">↗</span>
  </a>
</article>
